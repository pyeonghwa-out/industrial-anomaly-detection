# ───── Datasets & large downloads (never commit the ~5 GB dataset) ─────
# Root-anchored so it never matches the src/iad/datasets/ package.
/data/
/datasets/
*.tar.xz
*.tar.gz
*.zip
*.parquet

# ───── Model weights, memory banks, cached features ─────
*.pt
*.pth
*.ckpt
*.pkl
*.npz
*.npy
artifacts/
checkpoints/

# ───── Benchmark runs are regenerated (keep the folder, drop the contents) ─────
results/runs/*
!results/runs/.gitkeep
results/*.csv
# NOTE: example figures in results/figures/ are intentionally committed (kept).

# ───── Hugging Face / Torch caches, if ever redirected into the repo ─────
.cache/
.huggingface/

# ───── Python ─────
__pycache__/
*.py[cod]
*.egg
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.ipynb_checkpoints/

# ───── Testing / typing / linting ─────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ───── Secrets / environment ─────
.env
*.local.env

# ───── OS / editor cruft ─────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
