    "# 1) GPU + datasets\n",
    "import subprocess, sys, torch\n",
    "subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"datasets\"], check=False)\n",
    "print(\"CUDA:\", torch.cuda.is_available(),\n",
    "      torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"\")"
